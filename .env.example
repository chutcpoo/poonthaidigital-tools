# Existing application variables are configured in Vercel and are intentionally not copied here.
# Etsy alt-text endpoint: values must be configured as Vercel environment secrets only.
ETSY_ALT_TEXT_ENDPOINT_TOKEN=
ETSY_ALT_TEXT_WRITES_ENABLED=false
ETSY_ALT_TEXT_AUTHORIZATION_ID=
ETSY_ALT_TEXT_AUTHORIZED_UNTIL=

# Reuse the encrypted AutoDigitalPublisher OAuth token store without embedding tokens.
ETSY_TOKEN_DATABASE_URL=
ETSY_TOKEN_ENCRYPTION_KEY=
ETSY_API_KEY=
ETSY_SHARED_SECRET=
